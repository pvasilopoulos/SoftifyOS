{
  "name": "softifyos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:scale": "tsx scripts/seed-scale.ts",
    "db:seed:customers": "tsx scripts/seed-customers.ts",
    "db:seed:invoices": "tsx scripts/seed-invoices.ts",
    "db:seed:products": "tsx scripts/seed-products.ts",
    "db:seed:orders": "tsx scripts/seed-orders.ts",
    "db:seed:series": "tsx scripts/seed-document-series.ts",
    "db:seed:pos": "tsx scripts/seed-pos.ts",
    "db:bench": "tsx scripts/benchmark-audit.ts",
    "db:rls": "bash -c 'psql \"${DATABASE_URL%%\\?*}\" -f prisma/sql/rls.sql'",
    "db:rls:master": "bash -c 'psql \"${DATABASE_URL%%\\?*}\" -f prisma/sql/rls-master-data.sql'",
    "db:rls:invoices": "bash -c 'psql \"${DATABASE_URL%%\\?*}\" -f prisma/sql/rls-invoices.sql'",
    "db:rls:products": "bash -c 'psql \"${DATABASE_URL%%\\?*}\" -f prisma/sql/rls-products.sql'",
    "db:rls:orders": "bash -c 'psql \"${DATABASE_URL%%\\?*}\" -f prisma/sql/rls-orders.sql'",
    "db:rls:series": "bash -c 'psql \"${DATABASE_URL%%\\?*}\" -f prisma/sql/rls-document-series.sql'",
    "db:scale-indexes": "bash -c 'psql \"${DATABASE_URL%%\\?*}\" -f prisma/sql/scale-indexes.sql'",
    "db:setup": "prisma migrate dev --name phase0_platform && npm run db:seed && npm run db:rls",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "apexcharts": "^6.6.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.5",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.56.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-apexcharts": "^2.1.1",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "description": "SoftifyOS — Enterprise ERP platform (Template v2 + Phase 0)"
}
