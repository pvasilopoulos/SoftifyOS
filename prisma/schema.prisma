generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

/// Νομική μορφή πελάτη (Ελλάδα / ΕΕ)
enum CustomerLegalForm {
  AE
  OE
  EE
  IKE
  EPE
  INDIVIDUAL
  PUBLIC
  NGO
  OTHER
}

/// Καθεστώς ΦΠΑ
enum CustomerVatStatus {
  NORMAL
  EXEMPT
  INTRA_EU
  EXPORT
  OSS
}

/// Κατηγορία πελάτη
enum CustomerCategory {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
  PUBLIC
  INTERNAL
  OTHER
}

enum SpaceType {
  OFFICE
  WAREHOUSE
  FLOOR
  ROOM
  YARD
  OTHER
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  auditEvents      AuditEvent[]
  customers        Customer[]
  customerContacts CustomerContact[]
  branches         Branch[]
  spaces           Space[]
  invoices         Invoice[]
  products         Product[]
  orders           Order[]
  sites            Site[]
  documentSeries   DocumentSeries[]
  invoicePayments  InvoicePayment[]
  posSessions      PosSession[]
  posTerminals     PosTerminal[]
  giftCards        GiftCard[]
  giftCardLedgers  GiftCardLedger[]
  loyaltyAccounts  LoyaltyAccount[]
  loyaltyLedgers   LoyaltyLedger[]
  loyaltyProgram   LoyaltyProgram?
  paymentMethods               PaymentMethod[]
  documentSeriesPaymentMethods DocumentSeriesPaymentMethod[]
  documentSeriesPrintForms     DocumentSeriesPrintForm[]
  printForms                   PrintForm[]
  glAccounts                   GlAccount[]
  fiscalPeriods                FiscalPeriod[]
  journalEntries               JournalEntry[]
  legalEntities                LegalEntity[]
  costCenters                  CostCenter[]
  fixedAssets                  FixedAsset[]
  fixedAssetMovements          FixedAssetMovement[]
  purchaseInvoices             PurchaseInvoice[]
  parallelLedgers              ParallelLedger[]
  costAllocations              CostAllocation[]
  intercompanyMatches          IntercompanyMatch[]
  unitsOfMeasure               UnitOfMeasure[]
  tenantSettings               TenantSettings?
  appRoles                     AppRole[]
  userGroups                   UserGroup[]
  customFieldDefinitions       CustomFieldDefinition[]
  entityListViews              EntityListView[]
  entityFormViews              EntityFormView[]
  entityDetailLayouts          EntityDetailLayout[]
  scriptDefinitions            ScriptDefinition[]
  scriptSecrets                ScriptSecret[]
  scriptHttpAllowlist          ScriptHttpAllowlist[]
  scriptRunLogs                ScriptRunLog[]
  scriptSettings               ScriptSettings?
  stockBalances                StockBalance[]
  stockMovements               StockMovement[]
  suppliers                    Supplier[]
  purchaseOrders               PurchaseOrder[]
  deliveryNotes                DeliveryNote[]
  myDataSubmissions            MyDataSubmission[]
  employees                    Employee[]
  leaveTypes                   LeaveType[]
  leaveRequests                LeaveRequest[]
  workCards                    WorkCard[]
  workCardEvents               WorkCardEvent[]
  erganiSubmissions            ErganiSubmission[]
  payrollPeriods               PayrollPeriod[]
  payrollLines                 PayrollLine[]
  workShifts                   WorkShift[]
  workSchedules                WorkSchedule[]
  workScheduleAssignments      WorkScheduleAssignment[]
  crmLeads                     CrmLead[]
  crmActivities               CrmActivity[]
  savedFilters                 SavedFilter[]
  purchasePayments             PurchasePayment[]
  bankAccounts                 BankAccount[]
  bankStatementLines           BankStatementLine[]
  stockLots                    StockLot[]
  stockBins                    StockBin[]
  stockTransfers               StockTransfer[]
  stockCounts                  StockCount[]
  stockReservations            StockReservation[]
  stockSerials                 StockSerial[]
  pickWaves                    PickWave[]
  putawayRules                 PutawayRule[]
  unitConversions              UnitConversion[]
  orderStatusOptions           OrderStatusOption[]
  invoiceStatusOptions         InvoiceStatusOption[]
  documentTransformRules       DocumentTransformRule[]
  marketplaceChannels          MarketplaceChannel[]
  settlements                  Settlement[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Τελευταίος tenant που επέλεξε ο χρήστης (A)
  lastTenantId String?
  /// Prefs ανά tenant: { companies?: { [tenantId]: legalEntityId } }
  workspacePrefs Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  auditEvents AuditEvent[]

  @@map("users")
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(MEMBER)
  appRoleId String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appRole AppRole? @relation(fields: [appRoleId], references: [id], onDelete: SetNull)
  groups  UserGroupMember[]
  /// Κενό = όλες οι εταιρείες του tenant · αλλιώς μόνο αυτές
  companies MembershipCompany[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@index([tenantId, appRoleId])
  @@map("memberships")
}

/// B — προαιρετικός περιορισμός membership σε συγκεκριμένες LegalEntities
model MembershipCompany {
  id            String   @id @default(cuid())
  membershipId  String
  legalEntityId String
  createdAt     DateTime @default(now())

  membership  Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([membershipId, legalEntityId])
  @@index([legalEntityId])
  @@map("membership_companies")
}

model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, action, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Πελάτης — πλήρη master data ERP (ταυτότητα, φορολογικά, διεύθυνση, εμπορικά, τραπεζικά)
model Customer {
  id        String         @id @default(cuid())
  tenantId  String
  code      String
  /// Επωνυμία / νομική επωνυμία
  name      String
  /// Διακριτικός τίτλος
  tradeName String?
  legalForm CustomerLegalForm?
  /// Φυσικό πρόσωπο
  isPerson  Boolean        @default(false)

  vatNumber   String?
  taxOffice   String?
  gemhNumber  String?
  eoriNumber  String?
  vatStatus   CustomerVatStatus @default(NORMAL)
  profession  String?

  email   String?
  phone   String?
  mobile  String?
  fax     String?
  website String?

  address    String?
  address2   String?
  city       String?
  postalCode String?
  region     String?
  country    String  @default("GR")
  /// WGS84 — geocoded from customer HQ address (map pin)
  lat          Float?
  lng          Float?
  geocodedAt   DateTime?
  /// Last address string used for geocoding (skip re-geocode if unchanged)
  geocodeQuery String?

  shippingAddress    String?
  shippingAddress2   String?
  shippingCity       String?
  shippingPostalCode String?
  shippingRegion     String?
  shippingCountry    String?

  category           CustomerCategory?
  salesperson        String?
  paymentTermsDays   Int?
  paymentTermsLabel  String?
  creditLimit        Decimal? @db.Decimal(14, 2)
  currency           String   @default("EUR")
  locale             String   @default("el-GR")
  discountPercent    Decimal? @db.Decimal(5, 2)
  priceListCode      String?
  shippingMethod     String?

  iban              String?
  bic               String?
  bankName          String?
  bankAccountHolder String?

  isBlocked    Boolean        @default(false)
  sendEinvoice Boolean        @default(false)
  status       CustomerStatus @default(ACTIVE)
  notes        String?
  /// Hybrid custom fields: { [fieldCode]: value }
  customFields Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts CustomerContact[]
  branches Branch[]
  invoices Invoice[]
  orders   Order[]
  giftCards GiftCard[]
  loyaltyAccounts LoyaltyAccount[]
  deliveryNotes DeliveryNote[]
  settlements Settlement[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, vatNumber])
  @@index([tenantId, city])
  @@index([tenantId, category])
  @@index([tenantId, lat, lng])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("customers")
}

/// Επαφή / contact person πελάτη
model CustomerContact {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  name       String
  title      String?
  email      String?
  phone      String?
  mobile     String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, isPrimary])
  @@index([tenantId, customerId, createdAt(sort: Desc)])
  @@map("customer_contacts")
}

/// Υποκατάστημα πελάτη — έχει πολλούς χώρους
model Branch {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  code       String
  name       String
  address    String?
  address2   String?
  city       String?
  postalCode String?
  region     String?
  country    String?  @default("GR")
  email      String?
  phone      String?
  fax        String?
  /// WGS84 latitude for map / near-me queries
  lat        Float?
  /// WGS84 longitude for map / near-me queries
  lng        Float?
  geocodedAt DateTime?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  spaces   Space[]
  invoices Invoice[]
  orders   Order[]

  @@unique([tenantId, customerId, code])
  @@index([tenantId, customerId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, lat, lng])
  @@map("branches")
}

/// Χώρος μέσα σε υποκατάστημα (γραφείο, αποθήκη, όροφος κ.λπ.)
model Space {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String
  code        String
  name        String
  type        SpaceType @default(OTHER)
  floorLabel  String?
  areaSqm     Decimal?  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  orders   Order[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId, createdAt(sort: Desc)])
  @@index([tenantId, type, createdAt(sort: Desc)])
  @@map("spaces")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

/// Προϊόν / υπηρεσία καταλόγου — βάση για παραγγελίες & αποθήκη
model Product {
  id        String        @id @default(cuid())
  tenantId  String
  sku       String
  /// Barcode / EAN / QR payload for POS scan (optional)
  barcode   String?
  name      String
  /// Denormalized display symbol (from UnitOfMeasure.symbol)
  unit      String        @default("τεμ")
  unitId    String?
  vatRate   Decimal       @default(24) @db.Decimal(5, 2)
  price     Decimal       @db.Decimal(14, 2)
  status    ProductStatus @default(ACTIVE)
  /// When false, stock movements skip this product (services)
  trackInventory Boolean  @default(true)
  /// When true, IN/OUT can carry lot codes
  trackLots      Boolean  @default(false)
  /// When true, movements require serial numbers
  trackSerials   Boolean  @default(false)
  /// Soft reorder hint (units)
  reorderPoint   Decimal? @db.Decimal(14, 3)
  /// Moving average unit cost for inventory valuation
  averageCost    Decimal? @db.Decimal(14, 4)
  /// Secondary / pack UoM (dual UoM) — stock always in base unitId
  altUnitId      String?
  /// How many base units equal 1 alt unit (e.g. BOX→PCS = 12)
  altToBaseFactor Decimal? @db.Decimal(14, 6)
  notes     String?
  customFields Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitOfMeasure UnitOfMeasure? @relation("ProductBaseUnit", fields: [unitId], references: [id], onDelete: SetNull)
  altUnit       UnitOfMeasure? @relation("ProductAltUnit", fields: [altUnitId], references: [id], onDelete: SetNull)
  lines         OrderLine[]
  invoiceLines  InvoiceLine[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  stockLots     StockLot[]
  stockReservations StockReservation[]
  stockCountLines   StockCountLine[]
  stockTransferLines StockTransferLine[]
  stockSerials      StockSerial[]
  pickWaveLines     PickWaveLine[]
  putawayRules      PutawayRule[]
  unitConversions   UnitConversion[]
  purchaseOrderLines PurchaseOrderLine[]
  deliveryNoteLines DeliveryNoteLine[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@index([tenantId, unitId])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("products")
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum StockMovementSource {
  MANUAL
  INVOICE
  CREDIT
  ADJUSTMENT
  OPENING
  PURCHASE
  RECEIPT
  DELIVERY
  TRANSFER
  COUNT
  RESERVE
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COUNTED
  POSTED
  CANCELLED
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

/// Υπόλοιπο αποθέματος ανά προϊόν × υποκατάστημα (Site)
model StockBalance {
  id          String   @id @default(cuid())
  tenantId    String
  siteId      String
  productId   String
  qtyOnHand   Decimal  @default(0) @db.Decimal(14, 3)
  qtyReserved Decimal  @default(0) @db.Decimal(14, 3)
  binId       String?
  updatedAt   DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bin     StockBin? @relation(fields: [binId], references: [id], onDelete: SetNull)

  @@unique([tenantId, siteId, productId])
  @@index([tenantId, productId])
  @@index([tenantId, siteId])
  @@index([tenantId, binId])
  @@map("stock_balances")
}

/// Κίνηση αποθήκης (αμετάβλητο ιστορικό)
model StockMovement {
  id        String              @id @default(cuid())
  tenantId  String
  siteId    String
  productId String
  type      StockMovementType
  source    StockMovementSource @default(MANUAL)
  /// Absolute quantity of the movement (always ≥ 0) in base UoM
  qty       Decimal             @db.Decimal(14, 3)
  qtyBefore Decimal             @db.Decimal(14, 3)
  qtyAfter  Decimal             @db.Decimal(14, 3)
  /// Optional snapshot unit cost for valuation / in-transit
  unitCost  Decimal?            @db.Decimal(14, 4)
  note      String?
  lotCode   String?
  serial    String?
  uomId     String?
  /// Qty as entered in selected UoM (before conversion to base)
  qtyInUom  Decimal?            @db.Decimal(14, 3)
  refType   String?
  refId     String?
  userId    String?
  createdAt DateTime            @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, productId, createdAt(sort: Desc)])
  @@index([tenantId, siteId, createdAt(sort: Desc)])
  @@index([tenantId, refType, refId])
  @@index([tenantId, serial])
  @@map("stock_movements")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

/// Προμηθευτής
model Supplier {
  id           String         @id @default(cuid())
  tenantId     String
  code         String
  name         String
  vatNumber    String?
  email        String?
  phone        String?
  notes        String?
  status       SupplierStatus @default(ACTIVE)
  customFields Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders   PurchaseOrder[]
  purchasePayments PurchasePayment[]
  purchaseInvoices PurchaseInvoice[]
  settlements      Settlement[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("suppliers")
}

/// Παραγγελία αγοράς
model PurchaseOrder {
  id            String              @id @default(cuid())
  tenantId      String
  legalEntityId String
  supplierId    String
  siteId        String?
  seriesId      String?
  number        String
  status        PurchaseOrderStatus @default(DRAFT)
  orderedAt     DateTime            @default(now())
  currency      String              @default("EUR")
  subtotal      Decimal             @default(0) @db.Decimal(14, 2)
  vatAmount     Decimal             @default(0) @db.Decimal(14, 2)
  total         Decimal             @default(0) @db.Decimal(14, 2)
  notes         String?
  customFields  Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity         @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  site        Site?               @relation(fields: [siteId], references: [id], onDelete: SetNull)
  series      DocumentSeries?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  lines       PurchaseOrderLine[]
  payments    PurchasePayment[]

  @@unique([tenantId, legalEntityId, number])
  @@index([tenantId, legalEntityId, status, orderedAt(sort: Desc)])
  @@index([tenantId, supplierId, orderedAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(cuid())
  tenantId         String
  purchaseOrderId  String
  productId        String?
  position         Int
  description      String
  quantity         Decimal @db.Decimal(14, 3)
  quantityReceived Decimal @default(0) @db.Decimal(14, 3)
  unitPrice        Decimal @db.Decimal(14, 2)
  vatRate          Decimal @default(24) @db.Decimal(5, 2)
  lineTotal        Decimal @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, purchaseOrderId, position])
  @@index([tenantId, productId])
  @@map("purchase_order_lines")
}

enum DeliveryNoteStatus {
  DRAFT
  ISSUED
  CANCELLED
}

/// Δελτίο αποστολής — έξοδος εμπορευμάτων προς πελάτη
model DeliveryNote {
  id              String             @id @default(cuid())
  tenantId        String
  legalEntityId   String
  customerId      String
  siteId          String?
  seriesId        String?
  invoiceId       String?
  orderId         String?
  number          String
  status          DeliveryNoteStatus @default(DRAFT)
  issuedAt        DateTime?
  shippingAddress String?
  notes           String?
  customFields    Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity        @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site        Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  series      DocumentSeries?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  invoice     Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines       DeliveryNoteLine[]

  @@unique([tenantId, legalEntityId, number])
  @@index([tenantId, legalEntityId, status, issuedAt(sort: Desc)])
  @@index([tenantId, customerId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, orderId])
  @@index([tenantId, invoiceId])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id             String  @id @default(cuid())
  tenantId       String
  deliveryNoteId String
  productId      String?
  orderLineId    String?
  invoiceLineId  String?
  position       Int
  description    String
  quantity       Decimal @db.Decimal(14, 3)
  /// Qty already invoiced from this delivery line
  quantityInvoiced Decimal @default(0) @db.Decimal(14, 3)
  unit           String  @default("τεμ")

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderLine    OrderLine?   @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  invoiceLine  InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)

  @@index([tenantId, deliveryNoteId, position])
  @@index([tenantId, productId])
  @@index([tenantId, orderLineId])
  @@index([tenantId, invoiceLineId])
  @@map("delivery_note_lines")
}

enum TransformCoverageMode {
  FULL_COPY
  QUANTITY
}

enum TransformIssueMode {
  DRAFT
  ISSUE_NOW
}

/// Παραμετρικοί κανόνες μετασχηματισμού παραστατικών (τι → τι)
model DocumentTransformRule {
  id              String                @id @default(cuid())
  tenantId        String
  code            String
  name            String
  description     String?
  sourceKind      DocumentKind
  targetKind      DocumentKind
  /// Built-in engine handler key
  handlerKey      String
  isActive        Boolean               @default(true)
  isSystem        Boolean               @default(false)
  sortOrder       Int                   @default(0)
  allowPartial    Boolean               @default(true)
  coverageMode    TransformCoverageMode @default(QUANTITY)
  issueMode       TransformIssueMode    @default(ISSUE_NOW)
  copyNotes       Boolean               @default(true)
  defaultSeriesId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultSeries DocumentSeries? @relation(fields: [defaultSeriesId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId, sourceKind, isActive, sortOrder])
