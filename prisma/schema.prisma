generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SpaceType {
  OFFICE
  WAREHOUSE
  FLOOR
  ROOM
  YARD
  OTHER
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  auditEvents AuditEvent[]
  customers   Customer[]
  branches    Branch[]
  spaces      Space[]
  invoices    Invoice[]
  products    Product[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  auditEvents AuditEvent[]

  @@map("users")
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@map("memberships")
}

model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, action, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Πελάτης — έχει πολλά υποκαταστήματα
model Customer {
  id        String         @id @default(cuid())
  tenantId  String
  code      String
  name      String
  vatNumber String?
  email     String?
  phone     String?
  status    CustomerStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]
  invoices Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("customers")
}

/// Υποκατάστημα πελάτη — έχει πολλούς χώρους
model Branch {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  code       String
  name       String
  address    String?
  city       String?
  postalCode String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  spaces   Space[]
  invoices Invoice[]

  @@unique([tenantId, customerId, code])
  @@index([tenantId, customerId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("branches")
}

/// Χώρος μέσα σε υποκατάστημα (γραφείο, αποθήκη, όροφος κ.λπ.)
model Space {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String
  code        String
  name        String
  type        SpaceType @default(OTHER)
  floorLabel  String?
  areaSqm     Decimal?  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId, createdAt(sort: Desc)])
  @@index([tenantId, type, createdAt(sort: Desc)])
  @@map("spaces")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

/// Προϊόν / υπηρεσία καταλόγου — βάση για παραγγελίες & αποθήκη
model Product {
  id        String        @id @default(cuid())
  tenantId  String
  sku       String
  name      String
  unit      String        @default("τεμ")
  vatRate   Decimal       @default(24) @db.Decimal(5, 2)
  price     Decimal       @db.Decimal(14, 2)
  status    ProductStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("products")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

/// Τιμολόγιο — συνδέεται με πελάτη και προαιρετικά υποκατάστημα/χώρο
model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  customerId  String
  branchId    String?
  spaceId     String?
  number      String
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime?
  dueAt       DateTime?
  currency    String        @default("EUR")
  subtotal    Decimal       @db.Decimal(14, 2)
  vatAmount   Decimal       @db.Decimal(14, 2)
  total       Decimal       @db.Decimal(14, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  space    Space?        @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  lines    InvoiceLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status, issuedAt(sort: Desc)])
  @@index([tenantId, customerId, issuedAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, dueAt, status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  tenantId    String
  invoiceId   String
  position    Int
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId, position])
  @@map("invoice_lines")
}
