enum DocumentKind {
  SALES_ORDER
  SALES_INVOICE
  SALES_CREDIT
  CUSTOMER_RECEIPT
  DELIVERY_NOTE
  SALES_QUOTE
  RETAIL_RECEIPT
  PURCHASE_ORDER
  PURCHASE_INVOICE
  PURCHASE_CREDIT
  SUPPLIER_PAYMENT
  GOODS_RECEIPT
  STOCK_TRANSFER
  STOCK_RECEIPT
  STOCK_ISSUE
  CANCELLATION
}

enum NumberResetPolicy {
  NEVER
  YEARLY
}

enum CustomerEffect {
  NONE
  DEBIT
  CREDIT
}

enum InventoryEffect {
  NONE
  OUT
  IN
}

/// Σειρά παραστατικού — αρίθμηση + επιχειρησιακοί/φορολογικοί κανόνες
model DocumentSeries {
  id                   String            @id @default(cuid())
  tenantId             String
  legalEntityId        String
  code                 String
  name                 String
  kind                 DocumentKind
  prefix               String
  padLength            Int               @default(5)
  nextNumber           Int               @default(1)
  lastYear             Int?
  resetPolicy          NumberResetPolicy @default(YEARLY)
  siteId               String?
  affectsCustomer      CustomerEffect    @default(NONE)
  affectsInventory     InventoryEffect   @default(NONE)
  allowPartial         Boolean           @default(false)
  editableAfterIssue   Boolean           @default(false)
  myDataEnabled        Boolean           @default(false)
  myDataInvoiceType    String?
  myDataVatCategory    String?
  glDebitAccount       String?
  glCreditAccount      String?
  glVatAccount         String?
  /// Εξοφλήσεις: επιτρέπει ποσό < υπόλοιπο παραστατικού
  allowPartialSettlement Boolean         @default(true)
  /// Ποσοστό/ποσό άνω του υπολοίπου (υπερπληρωμή)
  allowOverpayment     Boolean           @default(false)
  /// Πολλαπλοί τρόποι πληρωμής στην ίδια εξόφληση
  allowMultiTender     Boolean           @default(true)
  /// Μέγιστος αριθμός τρόπων σε μία εξόφληση
  maxTenderLines       Int               @default(10)
  /// Πολλαπλά παραστατικά στην ίδια εξόφληση
  allowMultiDocumentSettlement Boolean   @default(false)
  /// Συμψηφισμός πιστωτικών στην ίδια εξόφληση
  allowCreditNoteOffset Boolean          @default(true)
  /// Προκαταβολή / υπόλοιπο υπέρ πελάτη (on-account)
  allowOnAccount       Boolean           @default(false)
  /// Διαγραφή μικροϋπολοίπου (write-off)
  allowWriteOff        Boolean           @default(false)
  /// Μέγιστο ποσό write-off (€)
  writeOffMaxAmount    Decimal           @default(0) @db.Decimal(14, 2)
  /// Ανοχή στρογγυλοποίησης (€) μεταξύ τρόπων και κατανομών
  settlementTolerance  Decimal           @default(0.01) @db.Decimal(14, 2)
  /// Ρέστα μετρητών (change)
  allowCashChange      Boolean           @default(true)
  /// Δωροκάρτα ως τρόπος εξόφλησης
  allowGiftCardTender  Boolean           @default(true)
  /// Πόντοι loyalty ως τρόπος εξόφλησης
  allowLoyaltyTender   Boolean           @default(true)
  /// Υποχρεωτικό externalRef / auth code σε κάθε τρόπο
  requireExternalRef   Boolean           @default(false)
  /// IMMEDIATE | CLEARING (κάρτα μέσω glClearingAccount)
  settlementClearingMode String          @default("IMMEDIATE")
  /// PAYMENT_DATE | DOCUMENT_DATE — ημερομηνία αξίας εξόφλησης
  settlementValueDateMode String         @default("PAYMENT_DATE")
  /// Αυτόματο λογιστικό άρθρο εξόφλησης
  autoPostSettlementJournal Boolean      @default(true)
  /// Επιτρέπει ακύρωση (void) εξόφλησης
  allowVoidSettlement  Boolean           @default(true)
  /// Επιτρέπει bank statement match σε παραστατικά της σειράς
  allowBankMatch       Boolean           @default(true)
  isDefault            Boolean           @default(false)
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  tenant         Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity    LegalEntity                   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  site           Site?                         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  invoices       Invoice[]
  orders         Order[]
  purchaseOrders PurchaseOrder[]
  deliveryNotes  DeliveryNote[]
  paymentMethods DocumentSeriesPaymentMethod[]
  printForms     DocumentSeriesPrintForm[]
  transformRules DocumentTransformRule[]

  @@unique([tenantId, legalEntityId, code])
  @@index([tenantId, legalEntityId, kind, isActive])
  @@index([tenantId, siteId, kind])
  @@map("document_series")
}

/// Allowed tenders for a document series (empty = all catalog methods allowed)
model DocumentSeriesPaymentMethod {
  id              String   @id @default(cuid())
  tenantId        String
  seriesId        String
  paymentMethodId String
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series        DocumentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod  @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([seriesId, paymentMethodId])
  @@index([tenantId, seriesId])
  @@index([tenantId, paymentMethodId])
  @@map("document_series_payment_methods")
}

enum SettlementKind {
  RECEIPT
  PAYMENT
  CLEARING
}

enum SettlementStatus {
  POSTED
  VOIDED
}

enum SettlementTargetType {
  INVOICE
  CREDIT_NOTE
  PURCHASE_INVOICE
  ON_ACCOUNT
}

/// Ολική / μερική / σύνθετη εξόφληση (AR ή AP) με πολλαπλούς τρόπους
model Settlement {
  id               String           @id @default(cuid())
  tenantId         String
  legalEntityId    String?
  number           String
  kind             SettlementKind
  status           SettlementStatus @default(POSTED)
  /// CUSTOMER | SUPPLIER
  partyType        String
  customerId       String?
  supplierId       String?
  currency         String           @default("EUR")
  totalAmount      Decimal          @db.Decimal(14, 2)
  settledAt        DateTime         @default(now())
  reference        String?
  notes            String?
  journalEntryId   String?
  clearingJournalId String?
  bankStatementLineId String?
  voidedAt         DateTime?
  voidedByUserId   String?
  createdByUserId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity?  @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier    Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  allocations SettlementAllocation[]
  methods     SettlementMethodLine[]
  invoicePayments InvoicePayment[]

  @@unique([tenantId, number])
  @@index([tenantId, kind, settledAt(sort: Desc)])
  @@index([tenantId, status, settledAt(sort: Desc)])
  @@index([tenantId, customerId, settledAt(sort: Desc)])
  @@index([tenantId, supplierId, settledAt(sort: Desc)])
  @@index([tenantId, legalEntityId])
  @@map("settlements")
}

model SettlementAllocation {
  id             String               @id @default(cuid())
  tenantId       String
  settlementId   String
  targetType     SettlementTargetType
  invoiceId      String?
  purchaseInvoiceId String?
  amount         Decimal              @db.Decimal(14, 2)
  createdAt      DateTime             @default(now())

  settlement      Settlement       @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId, settlementId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, purchaseInvoiceId])
  @@map("settlement_allocations")
}

model SettlementMethodLine {
  id               String   @id @default(cuid())
  tenantId         String
  settlementId     String
  paymentMethodId  String?
  methodCode       String
  amount           Decimal  @db.Decimal(14, 2)
  changeAmount     Decimal  @default(0) @db.Decimal(14, 2)
  externalRef      String?
  giftCardId       String?
  loyaltyAccountId String?
  /// true όταν χρησιμοποιήθηκε glClearingAccount (κάρτα)
  usesClearing     Boolean  @default(false)
  createdAt        DateTime @default(now())

  settlement    Settlement     @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([tenantId, settlementId])
  @@index([tenantId, paymentMethodId])
  @@map("settlement_method_lines")
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum PosTerminalProvider {
  MOCK
  VIVA
  WORLDLINE
  OTHER
}

enum GiftCardStatus {
  ACTIVE
  DEPLETED
  VOID
  EXPIRED
}

enum GiftCardLedgerKind {
  ISSUE
  REDEEM
  ADJUST
  VOID
  EXPIRE
}

enum LoyaltyLedgerKind {
  EARN
  REDEEM
  ADJUST
  VOID
}

/// Behavior contract for POS / collect — tenants add custom codes with a kind
enum PaymentMethodKind {
  CASH
  CARD
  TRANSFER
  GIFT_CARD
  LOYALTY
  OTHER
}

/// Tenant catalog of payment / tender methods (POS + εισπράξεις)
enum MarketplaceProvider {
  SKROUTZ
  BESTPRICE
  PUBLIC
  SHOPIFY
  WOOCOMMERCE
  AMAZON
  CUSTOM
}

enum MarketplaceChannelStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
}

/// Marketplace / e-commerce channel — sync via Script Hooks + secrets
model MarketplaceChannel {
  id                   String                   @id @default(cuid())
  tenantId             String
  code                 String
  name                 String
  provider             MarketplaceProvider
  status               MarketplaceChannelStatus @default(DRAFT)
  merchantId           String?
  externalShopId       String?
  /// ScriptSecret.key για API token (όχι raw secret)
  credentialsSecretKey String?
  apiBaseHost          String?
  apiBaseUrl           String?
  syncCatalog          Boolean                  @default(true)
  syncOrders           Boolean                  @default(true)
  syncStock            Boolean                  @default(false)
  syncPrices           Boolean                  @default(false)
  autoImportOrders     Boolean                  @default(false)
  isActive             Boolean                  @default(true)
  sortOrder            Int                      @default(100)
  notes                String?
  lastSyncAt           DateTime?
  lastError            String?
  metaJson             Json?
  customFields         Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, provider, isActive])
  @@index([tenantId, status, sortOrder])
  @@map("marketplace_channels")
}

model PaymentMethod {
  id                  String            @id @default(cuid())
  tenantId            String
  code                String
  name                String
  kind                PaymentMethodKind
  description         String?
  /// Κύριος λογ. λογαριασμός (ταμείο / τράπεζα / κάρτες)
  glAccount           String?
  /// Αντίστοιχος λογαριασμός (π.χ. πελάτες / εκκρεμείς)
  glContraAccount     String?
  /// Εκκαθάριση (κάρτες / ενδιάμεσος)
  glClearingAccount   String?
  costCenter          String?
  accountingCode      String?
  bankIban            String?
  bankName            String?
  /// Κωδικός τύπου πληρωμής myDATA (εφόσον ισχύει)
  myDataPaymentType   String?
  sortOrder           Int               @default(0)
  isActive            Boolean           @default(true)
  showInPos           Boolean           @default(true)
  showInCollect       Boolean           @default(true)
  requiresExternalRef Boolean           @default(false)
  allowsChange        Boolean           @default(false)
  affectsCashDrawer   Boolean           @default(false)
  isSystem            Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments    InvoicePayment[]
  seriesLinks DocumentSeriesPaymentMethod[]
  settlementMethods SettlementMethodLine[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@index([tenantId, showInPos, sortOrder])
  @@map("payment_methods")
}

/// Ανοιχτή βάρδια ταμείου POS
model PosSession {
  id             String           @id @default(cuid())
  tenantId       String
  siteId         String
  openedByUserId String
  status         PosSessionStatus @default(OPEN)
  openingFloat   Decimal          @default(0) @db.Decimal(14, 2)
  closingCash    Decimal?         @db.Decimal(14, 2)
  openedAt       DateTime         @default(now())
  closedAt       DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site     Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  payments InvoicePayment[]

  @@index([tenantId, status, openedAt(sort: Desc)])
  @@index([tenantId, siteId, status])
  @@map("pos_sessions")
}

/// Σύνδεση τερματικού κάρτας (config · live provider αργότερα)
model PosTerminal {
  id        String              @id @default(cuid())
  tenantId  String
  siteId    String
  code      String
  name      String
  provider  PosTerminalProvider @default(MOCK)
  isActive  Boolean             @default(true)
  configJson String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, siteId, isActive])
  @@map("pos_terminals")
}

model GiftCard {
  id             String         @id @default(cuid())
  tenantId       String
  code           String
  initialBalance Decimal        @db.Decimal(14, 2)
  balance        Decimal        @db.Decimal(14, 2)
  currency       String         @default("EUR")
  status         GiftCardStatus @default(ACTIVE)
  customerId     String?
  expiresAt      DateTime?
  notes          String?
  /// Παθητικό / υπόλοιπο δωροκαρτών (π.χ. 56.00.00)
  glLiabilityAccount String?
  /// Είσπραξη έκδοσης — ταμείο / τράπεζα (π.χ. 38.00.00)
  glCashAccount      String?
  /// Αντίστοιχος εξαργύρωσης — έσοδα / εκκαθάριση (π.χ. 70.00.00)
  glRedeemContraAccount String?
  costCenter     String?
  accountingCode String?
  customFields   Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments InvoicePayment[]
  ledger   GiftCardLedger[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("gift_cards")
}

model GiftCardLedger {
  id              String             @id @default(cuid())
  tenantId        String
  giftCardId      String
  kind            GiftCardLedgerKind
  /// Signed amount in EUR (+ issue/credit, − redeem/void)
  amount          Decimal            @db.Decimal(14, 2)
  balanceAfter    Decimal            @db.Decimal(14, 2)
  invoiceId       String?
  note            String?
  /// Snapshot λογιστικής κίνησης
  glDebitAccount  String?
  glCreditAccount String?
  createdByUserId String?
  createdAt       DateTime           @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([tenantId, giftCardId, createdAt(sort: Desc)])
  @@map("gift_card_ledgers")
}

/// Tenant loyalty earn/redeem policy
model LoyaltyProgram {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  name                String   @default("Standard")
  /// Points earned per 1 € sale
  earnPointsPerEur    Int      @default(1)
  /// Points required to redeem 1 €
  redeemPointsPerEur  Int      @default(100)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

model LoyaltyAccount {
  id            String   @id @default(cuid())
  tenantId      String
  customerId    String
  pointsBalance Int      @default(0)
  tier          String   @default("STANDARD")
  isActive      Boolean  @default(true)
  customFields  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ledger   LoyaltyLedger[]
  payments InvoicePayment[]

  @@unique([tenantId, customerId])
  @@index([tenantId, isActive])
  @@map("loyalty_accounts")
}

model LoyaltyLedger {
  id        String            @id @default(cuid())
  tenantId  String
  accountId String
  kind      LoyaltyLedgerKind
  points    Int
  invoiceId String?
  note      String?
  createdAt DateTime          @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId, createdAt(sort: Desc)])
  @@map("loyalty_ledgers")
}

/// Tenant-level UI / menu preferences
model TenantSettings {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  /// JSON MenuNodeConfig[]
  menuJson  Json?
  /// Default expand state for sidebar nav folders (user localStorage can override)
  navGroupsDefaultExpanded Boolean @default(true)
  /// Mobile footer shortcuts per user / group:
  /// { byUserId?: Record<userId, linkId[]>, byGroupId?: Record<groupId, linkId[]> }
  mobileFooterOverrides Json?

  /// Επωνυμία / εμπορική επωνυμία (override του Tenant.name για παραστατικά)
  legalName   String?
  tradeName   String?
  vatNumber   String?
  taxOffice   String?
  address     String?
  city        String?
  postalCode  String?
  country     String  @default("GR")
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  currency    String  @default("EUR")
  locale      String  @default("el-GR")
  timezone    String  @default("Europe/Athens")
  /// Όταν true, μη-OWNER βλέπουν banner συντήρησης
  maintenanceMode Boolean @default(false)
  /// Ελεύθερο JSON για integrations (webhooks, keys metadata)
  integrationsJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Custom role with permission codes (plus MembershipRole for backward compat)
model AppRole {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  /// Permission codes e.g. ["invoices.write","pos.use","users.manage"]
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  groups      UserGroupRole[]

  @@unique([tenantId, code])
  @@index([tenantId, isSystem])
  @@map("app_roles")
}

model UserGroup {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members UserGroupMember[]
  roles   UserGroupRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("user_groups")
}

model UserGroupMember {
  id           String   @id @default(cuid())
  tenantId     String
  groupId      String
  membershipId String
  createdAt    DateTime @default(now())

  group      UserGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([groupId, membershipId])
  @@index([tenantId, groupId])
  @@map("user_group_members")
}

model UserGroupRole {
  id        String   @id @default(cuid())
  tenantId  String
  groupId   String
  appRoleId String
  createdAt DateTime @default(now())

  group   UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  appRole AppRole   @relation(fields: [appRoleId], references: [id], onDelete: Cascade)

  @@unique([groupId, appRoleId])
  @@index([tenantId, groupId])
  @@map("user_group_roles")
}

// ─── Print Form Builder ─────────────────────────────────────────────

enum PrintPaperSize {
  A4
  A5
  A3
  LETTER
  RECEIPT_80
  CUSTOM
}

enum PrintOrientation {
  PORTRAIT
  LANDSCAPE
}

/// Parametric print form template (bodyJson = block layout)
model PrintForm {
  id            String           @id @default(cuid())
  tenantId      String
  code          String
  name          String
  documentKind  DocumentKind
  paper         PrintPaperSize   @default(A4)
  orientation   PrintOrientation @default(PORTRAIT)
  /// Block layout: header, parties, lines, totals, footer, text, spacer
  bodyJson      Json
  isDefault     Boolean          @default(false)
  isSystem      Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series DocumentSeriesPrintForm[]

  @@unique([tenantId, code])
  @@index([tenantId, documentKind, isActive])
  @@map("print_forms")
}

/// Which print forms a document series may use (grid in series settings)
model DocumentSeriesPrintForm {
  id          String   @id @default(cuid())
  tenantId    String
  seriesId    String
  printFormId String
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series    DocumentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  printForm PrintForm      @relation(fields: [printFormId], references: [id], onDelete: Cascade)

  @@unique([seriesId, printFormId])
  @@index([tenantId, seriesId])
  @@map("document_series_print_forms")
}

// ─── General Ledger / Accounting Suite ──────────────────────────────

enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

enum FiscalPeriodKind {
  YEAR
  MONTH
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

enum FixedAssetDepreciationMethod {
  STRAIGHT_LINE
}

enum FixedAssetMovementKind {
  ACQUIRE
  DEPRECIATE
  DISPOSE
  ADJUST
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PARTIAL
  PAID
  CANCELLED
}

model GlAccount {
  id          String        @id @default(cuid())
  tenantId    String
  code        String
  name        String
  type        GlAccountType
  parentId    String?
  /// BS_ASSET | BS_LIABILITY | BS_EQUITY | PL_REVENUE | PL_EXPENSE | PL_COGS
  reportGroup String?
  isPostable  Boolean       @default(true)
  isSystem    Boolean       @default(false)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   GlAccount?     @relation("GlAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children GlAccount[]    @relation("GlAccountTree")
  lines    JournalLine[]
  assetsAsAsset      FixedAsset[] @relation("FixedAssetGross")
  assetsAsAccumDepr  FixedAsset[] @relation("FixedAssetAccum")
  assetsAsDeprExp    FixedAsset[] @relation("FixedAssetDeprExp")
  purchaseInvoiceLines PurchaseInvoiceLine[]
  costAllocations    CostAllocation[] @relation("AllocationAccount")

  @@unique([tenantId, code])
  @@index([tenantId, type, isActive])
  @@index([tenantId, parentId])
  @@map("gl_accounts")
}

model FiscalPeriod {
  id             String             @id @default(cuid())
  tenantId       String
  code           String
  name           String
  year           Int
  month          Int?
  kind           FiscalPeriodKind   @default(YEAR)
  startsAt       DateTime
  endsAt         DateTime
  status         FiscalPeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journals JournalEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, year, status])
  @@index([tenantId, kind, year, month])
  @@map("fiscal_periods")
}

model LegalEntity {
  id         String   @id @default(cuid())
  tenantId   String
  code       String
  name       String
  vatNumber  String?
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines            JournalLine[]
  journals         JournalEntry[]
  assets           FixedAsset[]
  purchaseInvoices PurchaseInvoice[]
  invoices         Invoice[]
  orders           Order[]
  deliveryNotes    DeliveryNote[]
  purchaseOrders   PurchaseOrder[]
  documentSeries   DocumentSeries[]
  membershipAccess MembershipCompany[]
  settlements      Settlement[]
  icMatchesA       IntercompanyMatch[]  @relation("IcEntityA")
  icMatchesB       IntercompanyMatch[]  @relation("IcEntityB")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("legal_entities")
}

model CostCenter {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id], onDelete: SetNull)
  children CostCenter[] @relation("CostCenterTree")
  lines    JournalLine[]
  assets   FixedAsset[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  allocationsFrom CostAllocation[] @relation("AllocationSource")
  allocationTargets CostAllocationTarget[] @relation("AllocationTarget")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("cost_centers")
}

model ParallelLedger {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  /// STATUTORY | IFRS | MANAGEMENT | TAX
  kind      String   @default("STATUTORY")
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journals JournalEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("parallel_ledgers")
}

model JournalEntry {
  id               String        @id @default(cuid())
  tenantId         String
  legalEntityId    String?
  number           String
  status           JournalStatus @default(DRAFT)
  description      String?
  sourceType       String?
  sourceId         String?
  fiscalPeriodId   String?
  parallelLedgerId String?
  entryDate        DateTime      @default(now())
  isOpening        Boolean       @default(false)
  reversesId       String?       @unique
  postedAt         DateTime?
  voidedAt         DateTime?
  createdByUserId  String?
  customFields     Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity    LegalEntity?    @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  fiscalPeriod   FiscalPeriod?   @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)
  parallelLedger ParallelLedger? @relation(fields: [parallelLedgerId], references: [id], onDelete: SetNull)
  reverses       JournalEntry?   @relation("JournalReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy     JournalEntry?   @relation("JournalReversal")
  lines          JournalLine[]
  assetMovements FixedAssetMovement[]
  costAllocations CostAllocation[]
  intercompanyMatches IntercompanyMatch[]

  @@unique([tenantId, number])
  @@index([tenantId, status, postedAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, entryDate])
  @@index([tenantId, parallelLedgerId])
  @@index([tenantId, legalEntityId])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(cuid())
  tenantId       String
  journalEntryId String
  glAccountId    String
  costCenterId   String?
  legalEntityId  String?
  lineNo         Int     @default(0)
  memo           String?
  debit          Decimal @default(0) @db.Decimal(14, 2)
  credit         Decimal @default(0) @db.Decimal(14, 2)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  glAccount    GlAccount    @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  legalEntity  LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  icMatchLinesA IntercompanyMatchLine[] @relation("IcLineA")
  icMatchLinesB IntercompanyMatchLine[] @relation("IcLineB")

  @@index([tenantId, journalEntryId])
  @@index([tenantId, glAccountId])
  @@index([tenantId, costCenterId])
  @@index([tenantId, legalEntityId])
  @@map("journal_lines")
}

/// Κατανομή κόστους μεταξύ κέντρων κόστους (CO)
model CostAllocation {
  id               String   @id @default(cuid())
  tenantId         String
  code             String
  name             String
  /// EQUAL | PERCENT | DRIVER
  method           String   @default("PERCENT")
  sourceCostCenterId String
  glAccountId      String
  amount           Decimal  @db.Decimal(14, 2)
  status           String   @default("DRAFT")
  journalEntryId   String?
  postedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceCostCenter CostCenter  @relation("AllocationSource", fields: [sourceCostCenterId], references: [id], onDelete: Restrict)
  glAccount        GlAccount   @relation("AllocationAccount", fields: [glAccountId], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  targets          CostAllocationTarget[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("cost_allocations")
}

model CostAllocationTarget {
  id               String  @id @default(cuid())
  tenantId         String
  allocationId     String
  costCenterId     String
  /// Percent 0-100 or driver weight
  weight           Decimal @default(0) @db.Decimal(10, 4)
  amount           Decimal @default(0) @db.Decimal(14, 2)

  allocation CostAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  costCenter CostCenter     @relation("AllocationTarget", fields: [costCenterId], references: [id], onDelete: Restrict)

  @@index([tenantId, allocationId])
  @@map("cost_allocation_targets")
}

/// Διαταιρική αντιστοίχιση για consolidation eliminations
model IntercompanyMatch {
  id              String   @id @default(cuid())
  tenantId        String
  code            String
  legalEntityAId  String
  legalEntityBId  String
  amount          Decimal  @db.Decimal(14, 2)
  status          String   @default("OPEN")
  /// OPEN | MATCHED | ELIMINATED
  difference      Decimal  @default(0) @db.Decimal(14, 2)
  journalEntryId  String?
  notes           String?
  matchedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntityA LegalEntity   @relation("IcEntityA", fields: [legalEntityAId], references: [id], onDelete: Restrict)
  legalEntityB LegalEntity   @relation("IcEntityB", fields: [legalEntityBId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  lines        IntercompanyMatchLine[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("intercompany_matches")
}

model IntercompanyMatchLine {
  id        String  @id @default(cuid())
  tenantId  String
  matchId   String
  lineAId   String?
  lineBId   String?
  amount    Decimal @db.Decimal(14, 2)

  match IntercompanyMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  lineA JournalLine?      @relation("IcLineA", fields: [lineAId], references: [id], onDelete: SetNull)
  lineB JournalLine?      @relation("IcLineB", fields: [lineBId], references: [id], onDelete: SetNull)

  @@index([tenantId, matchId])
  @@map("intercompany_match_lines")
}

model FixedAsset {
  id                   String                        @id @default(cuid())
  tenantId             String
  code                 String
  name                 String
  acquisitionDate      DateTime
  acquisitionCost      Decimal                       @db.Decimal(14, 2)
  residualValue        Decimal                       @default(0) @db.Decimal(14, 2)
  usefulLifeMonths     Int                           @default(60)
  depreciationMethod   FixedAssetDepreciationMethod  @default(STRAIGHT_LINE)
  status               FixedAssetStatus              @default(ACTIVE)
  glAssetAccountId     String
  glAccumDeprAccountId String
  glDeprExpenseAccountId String
  costCenterId         String?
  legalEntityId        String?
  notes                String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  glAssetAccount   GlAccount    @relation("FixedAssetGross", fields: [glAssetAccountId], references: [id], onDelete: Restrict)
  glAccumDeprAccount GlAccount  @relation("FixedAssetAccum", fields: [glAccumDeprAccountId], references: [id], onDelete: Restrict)
  glDeprExpenseAccount GlAccount @relation("FixedAssetDeprExp", fields: [glDeprExpenseAccountId], references: [id], onDelete: Restrict)
  costCenter       CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  legalEntity      LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  movements        FixedAssetMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("fixed_assets")
}

model FixedAssetMovement {
  id             String                 @id @default(cuid())
  tenantId       String
  fixedAssetId   String
  kind           FixedAssetMovementKind
  amount         Decimal                @db.Decimal(14, 2)
  movedAt        DateTime               @default(now())
  memo           String?
  journalEntryId String?
  createdAt      DateTime               @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fixedAsset   FixedAsset    @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([tenantId, fixedAssetId, movedAt])
  @@map("fixed_asset_movements")
}

model PurchaseInvoice {
  id          String                @id @default(cuid())
  tenantId    String
  number      String
  supplierId  String
  status      PurchaseInvoiceStatus @default(DRAFT)
  issueDate   DateTime              @default(now())
  dueDate     DateTime?
  netAmount   Decimal               @default(0) @db.Decimal(14, 2)
  vatAmount   Decimal               @default(0) @db.Decimal(14, 2)
  total       Decimal               @default(0) @db.Decimal(14, 2)
  paidAmount  Decimal               @default(0) @db.Decimal(14, 2)
  notes       String?
  seriesId    String?
  legalEntityId String?
  journalEntryId String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  legalEntity LegalEntity?         @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  lines       PurchaseInvoiceLine[]
  settlementAllocations SettlementAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, status, issueDate])
  @@index([tenantId, supplierId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                String  @id @default(cuid())
  tenantId          String
  purchaseInvoiceId String
  lineNo            Int     @default(0)
  description       String
  qty               Decimal @default(1) @db.Decimal(14, 3)
  unitPrice         Decimal @default(0) @db.Decimal(14, 4)
  vatRate           Decimal @default(24) @db.Decimal(5, 2)
  netAmount         Decimal @default(0) @db.Decimal(14, 2)
  vatAmount         Decimal @default(0) @db.Decimal(14, 2)
  glAccountId       String?
  costCenterId      String?

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  glAccount       GlAccount?      @relation(fields: [glAccountId], references: [id], onDelete: SetNull)
  costCenter      CostCenter?     @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([tenantId, purchaseInvoiceId])
  @@map("purchase_invoice_lines")
}

// ─── Custom Fields & Entity Views ───────────────────────────────────

enum EntityModule {
  CUSTOMERS
  PRODUCTS
  INVOICES
  ORDERS
  QUOTES
  GIFT_CARDS
  SUPPLIERS
  PURCHASE_ORDERS
  DELIVERY_NOTES
  CRM_LEADS
  EMPLOYEES
  LOYALTY
  SITES
  JOURNAL_ENTRIES
  MARKETPLACE_CHANNELS
  PAYMENT_METHODS
  DOCUMENT_SERIES
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

model CustomFieldDefinition {
  id          String          @id @default(cuid())
  tenantId    String
  entity      EntityModule
  code        String
  label       String
  type        CustomFieldType @default(TEXT)
  /// For SELECT / MULTI_SELECT: string[]
  optionsJson Json?
  required    Boolean         @default(false)
  filterable  Boolean         @default(false)
  showInList  Boolean         @default(true)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity, code])
  @@index([tenantId, entity, isActive, sortOrder])
  @@map("custom_field_definitions")
}

/// Saved list layout per entity (columns, filters, sort)
model EntityListView {
  id          String       @id @default(cuid())
  tenantId    String
  entity      EntityModule
  code        String
  name        String
  description String?
  /// { columns: [{key,source}], filters: [...], sort?: {key,dir}, pageSize?: number }
  configJson  Json
  isDefault   Boolean      @default(false)
  isSystem    Boolean      @default(false)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity, code])
  @@index([tenantId, entity, isActive, sortOrder])
  @@map("entity_list_views")
}

/// Saved form layout per entity (sections + fields)
model EntityFormView {
  id          String       @id @default(cuid())
  tenantId    String
  entity      EntityModule
  code        String
  name        String
  description String?
  /// { sections: [{ id, title, fields: [{key,source,required?}] }] }
  configJson  Json
  isDefault   Boolean      @default(false)
  isSystem    Boolean      @default(false)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity, code])
  @@index([tenantId, entity, isActive, sortOrder])
  @@map("entity_form_views")
}

/// Detail page layout per entity (tab order / visibility on 360 views)
model EntityDetailLayout {
  id         String       @id @default(cuid())
  tenantId   String
  entity     EntityModule
  /// { tabs: [{ key, label?, visible }], defaultTab?: string }
  configJson Json
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity])
  @@index([tenantId, entity])
  @@map("entity_detail_layouts")
}

// ─── Script Hooks Engine ────────────────────────────────────────────

enum ScriptRuntime {
  SERVER
  UI
  BOTH
}

enum ScriptLifecycle {
  DRAFT
  PUBLISHED
}

enum ScriptRunSource {
  PRODUCTION
  TEST
}

/// Per-tenant kill switch & defaults for custom scripts
model ScriptSettings {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  scriptsEnabled  Boolean  @default(true)
  maxTimeoutMs    Int      @default(3000)
  maxHttpCalls    Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("script_settings")
}

/// Custom JS hooks per module event
model ScriptDefinition {
  id          String          @id @default(cuid())
  tenantId    String
  module      EntityModule
  code        String
  name        String
  description String?
  /// e.g. before.create, after.update, form.beforeSubmit
  eventKey    String
  runtime     ScriptRuntime   @default(SERVER)
  source      String          @db.Text
  lifecycle   ScriptLifecycle @default(DRAFT)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  timeoutMs   Int             @default(3000)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  updatedById String?

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   ScriptRunLog[]

  @@unique([tenantId, module, code])
  @@index([tenantId, module, eventKey, isActive, lifecycle])
  @@map("script_definitions")
}

/// Encrypted secrets for script HTTP auth (MARKETPLACE_TOKEN, …)
model ScriptSecret {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  valueEnc  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("script_secrets")
}

/// Allow-listed hosts for api.http.* outbound calls
model ScriptHttpAllowlist {
  id        String   @id @default(cuid())
  tenantId  String
  host      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, host])
  @@index([tenantId])
  @@map("script_http_allowlist")
}

model ScriptRunLog {
  id             String          @id @default(cuid())
  tenantId       String
  scriptId       String?
  module         EntityModule
  eventKey       String
  success        Boolean
  durationMs     Int
  error          String?
  httpCalls      Int             @default(0)
  /// PRODUCTION (API dispatch) or TEST (settings test run)
  source         ScriptRunSource @default(PRODUCTION)
  scriptCode     String?
  scriptName     String?
  userId         String?
  userEmail      String?
  userName       String?
  userRole       String?
  /// Related entity id when available (customer id, …)
  recordId       String?
  recordCode     String?
  /// Truncated api.log lines
  logsJson       Json?
  /// Small snapshot of record keys for debugging
  recordSnapshot Json?
  createdAt      DateTime        @default(now())

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  script ScriptDefinition? @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, module, eventKey])
  @@index([tenantId, success, createdAt])
  @@index([tenantId, source, createdAt])
  @@index([tenantId, scriptCode])
  @@index([tenantId, userId])
  @@index([tenantId, recordId])
  @@map("script_run_logs")
}
