/// Εργαζόμενος — ελληνικό HR master (ΑΦΜ/ΑΜΚΑ/ΕΦΚΑ, σύμβαση)
model Employee {
  id               String         @id @default(cuid())
  tenantId         String
  code             String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  title            String?
  department       String?
  /// ΑΦΜ
  vatNumber        String?
  /// ΑΜΚΑ
  amka             String?
  /// ΑΜΑ ΕΦΚΑ
  ama              String?
  iban             String?
  birthDate        DateTime?
  address          String?
  city             String?
  postalCode       String?
  nationality      String         @default("GR")
  /// INDEFINITE | FIXED | PART_TIME | SEASONAL | INTERNSHIP
  contractType     String         @default("INDEFINITE")
  specialty        String?
  weeklyHours      Decimal?       @db.Decimal(5, 2)
  /// Μηνιαίο μικτό βάσης για μισθοδοσία
  baseGross        Decimal?       @db.Decimal(14, 2)
  /// Επιδόματα / προσαυξήσεις (μηνιαία)
  monthlyAllowance Decimal        @default(0) @db.Decimal(14, 2)
  siteId           String?
  hireDate         DateTime?
  terminationDate  DateTime?
  erganiEmployeeId String?
  status           EmployeeStatus @default(ACTIVE)
  notes            String?
  customFields     Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site            Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  leaveRequests   LeaveRequest[]
  workCards       WorkCard[]
  workCardEvents  WorkCardEvent[]
  payrollLines    PayrollLine[]
  workShifts      WorkShift[]
  scheduleLinks   WorkScheduleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, vatNumber])
  @@index([tenantId, siteId])
  @@map("employees")
}

