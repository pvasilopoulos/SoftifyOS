  site     Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, employeeId, occurredAt(sort: Desc)])
  @@index([tenantId, erganiStatus, occurredAt(sort: Desc)])
