  @@unique([tenantId, cardNumber])
  @@unique([tenantId, qrToken])
  @@index([tenantId, employeeId, status])
  @@map("work_cards")
}

/// Χτύπημα κάρτας / παρουσία
model WorkCardEvent {
  id           String              @id @default(cuid())
