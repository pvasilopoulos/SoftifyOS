generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SpaceType {
  OFFICE
  WAREHOUSE
  FLOOR
  ROOM
  YARD
  OTHER
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  auditEvents      AuditEvent[]
  customers        Customer[]
  branches         Branch[]
  spaces           Space[]
  invoices         Invoice[]
  products         Product[]
  orders           Order[]
  sites            Site[]
  documentSeries   DocumentSeries[]
  invoicePayments  InvoicePayment[]
  posSessions      PosSession[]
  posTerminals     PosTerminal[]
  giftCards        GiftCard[]
  giftCardLedgers  GiftCardLedger[]
  loyaltyAccounts  LoyaltyAccount[]
  loyaltyLedgers   LoyaltyLedger[]
  loyaltyProgram   LoyaltyProgram?
  paymentMethods               PaymentMethod[]
  documentSeriesPaymentMethods DocumentSeriesPaymentMethod[]
  documentSeriesPrintForms     DocumentSeriesPrintForm[]
  printForms                   PrintForm[]
  glAccounts                   GlAccount[]
  fiscalPeriods                FiscalPeriod[]
  journalEntries               JournalEntry[]
  unitsOfMeasure               UnitOfMeasure[]
  tenantSettings               TenantSettings?
  appRoles                     AppRole[]
  userGroups                   UserGroup[]
  customFieldDefinitions       CustomFieldDefinition[]
  entityListViews              EntityListView[]
  entityFormViews              EntityFormView[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  auditEvents AuditEvent[]

  @@map("users")
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(MEMBER)
  appRoleId String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appRole AppRole? @relation(fields: [appRoleId], references: [id], onDelete: SetNull)
  groups  UserGroupMember[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@index([tenantId, appRoleId])
  @@map("memberships")
}

model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, action, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Πελάτης — έχει πολλά υποκαταστήματα
model Customer {
  id        String         @id @default(cuid())
  tenantId  String
  code      String
  name      String
  vatNumber String?
  email     String?
  phone     String?
  status    CustomerStatus @default(ACTIVE)
  notes     String?
  /// Hybrid custom fields: { [fieldCode]: value }
  customFields Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]
  invoices Invoice[]
  orders   Order[]
  giftCards GiftCard[]
  loyaltyAccounts LoyaltyAccount[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("customers")
}

/// Υποκατάστημα πελάτη — έχει πολλούς χώρους
model Branch {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  code       String
  name       String
  address    String?
  city       String?
  postalCode String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  spaces   Space[]
  invoices Invoice[]
  orders   Order[]

  @@unique([tenantId, customerId, code])
  @@index([tenantId, customerId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("branches")
}

/// Χώρος μέσα σε υποκατάστημα (γραφείο, αποθήκη, όροφος κ.λπ.)
model Space {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String
  code        String
  name        String
  type        SpaceType @default(OTHER)
  floorLabel  String?
  areaSqm     Decimal?  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  orders   Order[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId, createdAt(sort: Desc)])
  @@index([tenantId, type, createdAt(sort: Desc)])
  @@map("spaces")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

/// Προϊόν / υπηρεσία καταλόγου — βάση για παραγγελίες & αποθήκη
model Product {
  id        String        @id @default(cuid())
  tenantId  String
  sku       String
  /// Barcode / EAN / QR payload for POS scan (optional)
  barcode   String?
  name      String
  /// Denormalized display symbol (from UnitOfMeasure.symbol)
  unit      String        @default("τεμ")
  unitId    String?
  vatRate   Decimal       @default(24) @db.Decimal(5, 2)
  price     Decimal       @db.Decimal(14, 2)
  status    ProductStatus @default(ACTIVE)
  notes     String?
  customFields Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitOfMeasure UnitOfMeasure? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  lines         OrderLine[]
  invoiceLines  InvoiceLine[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@index([tenantId, unitId])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("products")
}

enum UnitOfMeasureKind {
  COUNT
  WEIGHT
  VOLUME
  LENGTH
  AREA
  TIME
  OTHER
}

/// Παραμετρικές μονάδες μέτρησης ανά tenant
model UnitOfMeasure {
  id          String            @id @default(cuid())
  tenantId    String
  /// Stable code e.g. PCS, KG, LT
  code        String
  name        String
  /// Short symbol shown on products / docs e.g. τεμ, kg
  symbol      String
  kind        UnitOfMeasureKind @default(COUNT)
  /// Decimal places allowed for quantities
  decimals    Int               @default(0)
  description String?
  sortOrder   Int               @default(100)
  isActive    Boolean           @default(true)
  isDefault   Boolean           @default(false)
  isSystem    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, code])
  @@unique([tenantId, symbol])
  @@index([tenantId, isActive, sortOrder])
  @@index([tenantId, kind, sortOrder])
  @@map("units_of_measure")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

/// Sales fiscal docs that share the Invoice table / workspace
enum InvoiceKind {
  SALES_INVOICE
  SALES_CREDIT
  RETAIL_RECEIPT
}

/// Τιμολόγιο / πιστωτικό / ΑΠΥ — συνδέεται με πελάτη και προαιρετικά υποκατάστημα/χώρο
model Invoice {
  id                String        @id @default(cuid())
  tenantId          String
  customerId        String
  branchId          String?
  spaceId           String?
  orderId           String?
  seriesId          String?
  siteId            String?
  relatedInvoiceId  String?
  kind              InvoiceKind   @default(SALES_INVOICE)
  number            String
  status            InvoiceStatus @default(DRAFT)
  issuedAt          DateTime?
  dueAt             DateTime?
  currency          String        @default("EUR")
  subtotal          Decimal       @db.Decimal(14, 2)
  vatAmount         Decimal       @db.Decimal(14, 2)
  total             Decimal       @db.Decimal(14, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(14, 2)
  notes             String?
  customFields      Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  space           Space?           @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  series          DocumentSeries?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  site            Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  relatedInvoice  Invoice?         @relation("InvoiceCredits", fields: [relatedInvoiceId], references: [id], onDelete: SetNull)
  creditNotes     Invoice[]        @relation("InvoiceCredits")
  lines           InvoiceLine[]
  payments        InvoicePayment[]

  @@unique([tenantId, number])
  @@index([tenantId, status, issuedAt(sort: Desc)])
  @@index([tenantId, customerId, issuedAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, dueAt, status])
  @@index([tenantId, orderId])
  @@index([tenantId, seriesId])
  @@index([tenantId, kind, createdAt(sort: Desc)])
  @@index([tenantId, relatedInvoiceId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  tenantId    String
  invoiceId   String
  productId   String?
  orderLineId String?
  position    Int
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId, position])
  @@index([tenantId, productId])
  @@index([tenantId, orderLineId])
  @@map("invoice_lines")
}

model InvoicePayment {
  id               String   @id @default(cuid())
  tenantId         String
  invoiceId        String
  amount           Decimal  @db.Decimal(14, 2)
  /// Stable code from PaymentMethod catalog (e.g. CASH, CARD_VIVA)
  method           String   @default("OTHER")
  paymentMethodId  String?
  note             String?
  changeAmount     Decimal  @default(0) @db.Decimal(14, 2)
  externalRef      String?
  posSessionId     String?
  giftCardId       String?
  loyaltyAccountId String?
  paidAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentMethod  PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  posSession     PosSession?     @relation(fields: [posSessionId], references: [id], onDelete: SetNull)
  giftCard       GiftCard?       @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  loyaltyAccount LoyaltyAccount? @relation(fields: [loyaltyAccountId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId, paidAt(sort: Desc)])
  @@index([tenantId, posSessionId])
  @@index([tenantId, paymentMethodId])
  @@map("invoice_payments")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PARTIAL_INVOICED
  INVOICED
  CANCELLED
}

enum OrderKind {
  SALES_ORDER
  SALES_QUOTE
}

/// Παραγγελία / προσφορά πώλησης — προσφορά μετατρέπεται σε παραγγελία
model Order {
  id            String      @id @default(cuid())
  tenantId      String
  customerId    String
  branchId      String?
  spaceId       String?
  seriesId      String?
  siteId        String?
  sourceQuoteId String?
  kind          OrderKind   @default(SALES_ORDER)
  number        String
  status        OrderStatus @default(DRAFT)
  orderedAt     DateTime    @default(now())
  currency      String      @default("EUR")
  subtotal      Decimal     @db.Decimal(14, 2)
  vatAmount     Decimal     @db.Decimal(14, 2)
  total         Decimal     @db.Decimal(14, 2)
  notes         String?
  customFields  Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch      Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  space       Space?          @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  series      DocumentSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  site        Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  sourceQuote Order?          @relation("QuoteToOrder", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  convertedOrders Order[]     @relation("QuoteToOrder")
  lines       OrderLine[]
  invoices    Invoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status, orderedAt(sort: Desc)])
  @@index([tenantId, customerId, orderedAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, seriesId])
  @@index([tenantId, kind, createdAt(sort: Desc)])
  @@index([tenantId, sourceQuoteId])
  @@map("orders")
}

model OrderLine {
  id               String  @id @default(cuid())
  tenantId         String
  orderId          String
  productId        String?
  position         Int
  description      String
  quantity         Decimal @db.Decimal(14, 3)
  quantityInvoiced Decimal @default(0) @db.Decimal(14, 3)
  unitPrice        Decimal @db.Decimal(14, 2)
  vatRate          Decimal @db.Decimal(5, 2)
  lineTotal        Decimal @db.Decimal(14, 2)

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  invoiceLines InvoiceLine[]

  @@index([tenantId, orderId, position])
  @@index([tenantId, productId])
  @@map("order_lines")
}

enum SiteKind {
  BRANCH
  TILL
}

/// Υποκατάστημα / ταμείο εταιρείας (όχι πελάτη)
model Site {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  kind      SiteKind @default(BRANCH)
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Site?            @relation("SiteTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Site[]           @relation("SiteTree")
  series   DocumentSeries[]
  invoices Invoice[]
  orders   Order[]
  posSessions PosSession[]
  posTerminals PosTerminal[]

  @@unique([tenantId, code])
  @@index([tenantId, kind, isActive])
  @@map("sites")
}

enum DocumentKind {
  SALES_ORDER
  SALES_INVOICE
  SALES_CREDIT
  CUSTOMER_RECEIPT
  DELIVERY_NOTE
  SALES_QUOTE
  RETAIL_RECEIPT
  PURCHASE_ORDER
  PURCHASE_INVOICE
  PURCHASE_CREDIT
  SUPPLIER_PAYMENT
  GOODS_RECEIPT
  STOCK_TRANSFER
  STOCK_RECEIPT
  STOCK_ISSUE
  CANCELLATION
}

enum NumberResetPolicy {
  NEVER
  YEARLY
}

enum CustomerEffect {
  NONE
  DEBIT
  CREDIT
}

enum InventoryEffect {
  NONE
  OUT
  IN
}

/// Σειρά παραστατικού — αρίθμηση + επιχειρησιακοί/φορολογικοί κανόνες
model DocumentSeries {
  id                   String            @id @default(cuid())
  tenantId             String
  code                 String
  name                 String
  kind                 DocumentKind
  prefix               String
  padLength            Int               @default(5)
  nextNumber           Int               @default(1)
  lastYear             Int?
  resetPolicy          NumberResetPolicy @default(YEARLY)
  siteId               String?
  affectsCustomer      CustomerEffect    @default(NONE)
  affectsInventory     InventoryEffect   @default(NONE)
  allowPartial         Boolean           @default(false)
  editableAfterIssue   Boolean           @default(false)
  myDataEnabled        Boolean           @default(false)
  myDataInvoiceType    String?
  myDataVatCategory    String?
  glDebitAccount       String?
  glCreditAccount      String?
  glVatAccount         String?
  isDefault            Boolean           @default(false)
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  tenant         Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site           Site?                         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  invoices       Invoice[]
  orders         Order[]
  paymentMethods DocumentSeriesPaymentMethod[]
  printForms     DocumentSeriesPrintForm[]

  @@unique([tenantId, code])
  @@index([tenantId, kind, isActive])
  @@index([tenantId, siteId, kind])
  @@map("document_series")
}

/// Allowed tenders for a document series (empty = all catalog methods allowed)
model DocumentSeriesPaymentMethod {
  id              String   @id @default(cuid())
  tenantId        String
  seriesId        String
  paymentMethodId String
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series        DocumentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod  @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([seriesId, paymentMethodId])
  @@index([tenantId, seriesId])
  @@index([tenantId, paymentMethodId])
  @@map("document_series_payment_methods")
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum PosTerminalProvider {
  MOCK
  VIVA
  WORLDLINE
  OTHER
}

enum GiftCardStatus {
  ACTIVE
  DEPLETED
  VOID
  EXPIRED
}

enum GiftCardLedgerKind {
  ISSUE
  REDEEM
  ADJUST
  VOID
  EXPIRE
}

enum LoyaltyLedgerKind {
  EARN
  REDEEM
  ADJUST
  VOID
}

/// Behavior contract for POS / collect — tenants add custom codes with a kind
enum PaymentMethodKind {
  CASH
  CARD
  TRANSFER
  GIFT_CARD
  LOYALTY
  OTHER
}

/// Tenant catalog of payment / tender methods (POS + εισπράξεις)
model PaymentMethod {
  id                  String            @id @default(cuid())
  tenantId            String
  code                String
  name                String
  kind                PaymentMethodKind
  description         String?
  /// Κύριος λογ. λογαριασμός (ταμείο / τράπεζα / κάρτες)
  glAccount           String?
  /// Αντίστοιχος λογαριασμός (π.χ. πελάτες / εκκρεμείς)
  glContraAccount     String?
  /// Εκκαθάριση (κάρτες / ενδιάμεσος)
  glClearingAccount   String?
  costCenter          String?
  accountingCode      String?
  bankIban            String?
  bankName            String?
  /// Κωδικός τύπου πληρωμής myDATA (εφόσον ισχύει)
  myDataPaymentType   String?
  sortOrder           Int               @default(0)
  isActive            Boolean           @default(true)
  showInPos           Boolean           @default(true)
  showInCollect       Boolean           @default(true)
  requiresExternalRef Boolean           @default(false)
  allowsChange        Boolean           @default(false)
  affectsCashDrawer   Boolean           @default(false)
  isSystem            Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments    InvoicePayment[]
  seriesLinks DocumentSeriesPaymentMethod[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@index([tenantId, showInPos, sortOrder])
  @@map("payment_methods")
}

/// Ανοιχτή βάρδια ταμείου POS
model PosSession {
  id             String           @id @default(cuid())
  tenantId       String
  siteId         String
  openedByUserId String
  status         PosSessionStatus @default(OPEN)
  openingFloat   Decimal          @default(0) @db.Decimal(14, 2)
  closingCash    Decimal?         @db.Decimal(14, 2)
  openedAt       DateTime         @default(now())
  closedAt       DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site     Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  payments InvoicePayment[]

  @@index([tenantId, status, openedAt(sort: Desc)])
  @@index([tenantId, siteId, status])
  @@map("pos_sessions")
}

/// Σύνδεση τερματικού κάρτας (config · live provider αργότερα)
model PosTerminal {
  id        String              @id @default(cuid())
  tenantId  String
  siteId    String
  code      String
  name      String
  provider  PosTerminalProvider @default(MOCK)
  isActive  Boolean             @default(true)
  configJson String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, siteId, isActive])
  @@map("pos_terminals")
}

model GiftCard {
  id             String         @id @default(cuid())
  tenantId       String
  code           String
  initialBalance Decimal        @db.Decimal(14, 2)
  balance        Decimal        @db.Decimal(14, 2)
  currency       String         @default("EUR")
  status         GiftCardStatus @default(ACTIVE)
  customerId     String?
  expiresAt      DateTime?
  notes          String?
  /// Παθητικό / υπόλοιπο δωροκαρτών (π.χ. 56.00.00)
  glLiabilityAccount String?
  /// Είσπραξη έκδοσης — ταμείο / τράπεζα (π.χ. 38.00.00)
  glCashAccount      String?
  /// Αντίστοιχος εξαργύρωσης — έσοδα / εκκαθάριση (π.χ. 70.00.00)
  glRedeemContraAccount String?
  costCenter     String?
  accountingCode String?
  customFields   Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments InvoicePayment[]
  ledger   GiftCardLedger[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("gift_cards")
}

model GiftCardLedger {
  id              String             @id @default(cuid())
  tenantId        String
  giftCardId      String
  kind            GiftCardLedgerKind
  /// Signed amount in EUR (+ issue/credit, − redeem/void)
  amount          Decimal            @db.Decimal(14, 2)
  balanceAfter    Decimal            @db.Decimal(14, 2)
  invoiceId       String?
  note            String?
  /// Snapshot λογιστικής κίνησης
  glDebitAccount  String?
  glCreditAccount String?
  createdByUserId String?
  createdAt       DateTime           @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([tenantId, giftCardId, createdAt(sort: Desc)])
  @@map("gift_card_ledgers")
}

/// Tenant loyalty earn/redeem policy
model LoyaltyProgram {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  name                String   @default("Standard")
  /// Points earned per 1 € sale
  earnPointsPerEur    Int      @default(1)
  /// Points required to redeem 1 €
  redeemPointsPerEur  Int      @default(100)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

model LoyaltyAccount {
  id            String   @id @default(cuid())
  tenantId      String
  customerId    String
  pointsBalance Int      @default(0)
  tier          String   @default("STANDARD")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ledger   LoyaltyLedger[]
  payments InvoicePayment[]

  @@unique([tenantId, customerId])
  @@index([tenantId, isActive])
  @@map("loyalty_accounts")
}

model LoyaltyLedger {
  id        String            @id @default(cuid())
  tenantId  String
  accountId String
  kind      LoyaltyLedgerKind
  points    Int
  invoiceId String?
  note      String?
  createdAt DateTime          @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId, createdAt(sort: Desc)])
  @@map("loyalty_ledgers")
}

/// Tenant-level UI / menu preferences
model TenantSettings {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  /// JSON MenuNodeConfig[]
  menuJson  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Custom role with permission codes (plus MembershipRole for backward compat)
model AppRole {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  /// Permission codes e.g. ["invoices.write","pos.use","users.manage"]
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  groups      UserGroupRole[]

  @@unique([tenantId, code])
  @@index([tenantId, isSystem])
  @@map("app_roles")
}

model UserGroup {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members UserGroupMember[]
  roles   UserGroupRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("user_groups")
}

model UserGroupMember {
  id           String   @id @default(cuid())
  tenantId     String
  groupId      String
  membershipId String
  createdAt    DateTime @default(now())

  group      UserGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([groupId, membershipId])
  @@index([tenantId, groupId])
  @@map("user_group_members")
}

model UserGroupRole {
  id        String   @id @default(cuid())
  tenantId  String
  groupId   String
  appRoleId String
  createdAt DateTime @default(now())

  group   UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  appRole AppRole   @relation(fields: [appRoleId], references: [id], onDelete: Cascade)

  @@unique([groupId, appRoleId])
  @@index([tenantId, groupId])
  @@map("user_group_roles")
}

// ─── Print Form Builder ─────────────────────────────────────────────

enum PrintPaperSize {
  A4
  A5
  RECEIPT_80
}

enum PrintOrientation {
  PORTRAIT
  LANDSCAPE
}

/// Parametric print form template (bodyJson = block layout)
model PrintForm {
  id            String           @id @default(cuid())
  tenantId      String
  code          String
  name          String
  documentKind  DocumentKind
  paper         PrintPaperSize   @default(A4)
  orientation   PrintOrientation @default(PORTRAIT)
  /// Block layout: header, parties, lines, totals, footer, text, spacer
  bodyJson      Json
  isDefault     Boolean          @default(false)
  isSystem      Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series DocumentSeriesPrintForm[]

  @@unique([tenantId, code])
  @@index([tenantId, documentKind, isActive])
  @@map("print_forms")
}

/// Which print forms a document series may use (grid in series settings)
model DocumentSeriesPrintForm {
  id          String   @id @default(cuid())
  tenantId    String
  seriesId    String
  printFormId String
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series    DocumentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  printForm PrintForm      @relation(fields: [printFormId], references: [id], onDelete: Cascade)

  @@unique([seriesId, printFormId])
  @@index([tenantId, seriesId])
  @@map("document_series_print_forms")
}

// ─── General Ledger ─────────────────────────────────────────────────

enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

model GlAccount {
  id         String        @id @default(cuid())
  tenantId   String
  code       String
  name       String
  type       GlAccountType
  parentId   String?
  isPostable Boolean       @default(true)
  isSystem   Boolean       @default(false)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   GlAccount?     @relation("GlAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children GlAccount[]    @relation("GlAccountTree")
  lines    JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type, isActive])
  @@index([tenantId, parentId])
  @@map("gl_accounts")
}

model FiscalPeriod {
  id        String             @id @default(cuid())
  tenantId  String
  code      String
  name      String
  year      Int
  startsAt  DateTime
  endsAt    DateTime
  status    FiscalPeriodStatus @default(OPEN)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journals JournalEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, year, status])
  @@map("fiscal_periods")
}

model JournalEntry {
  id             String        @id @default(cuid())
  tenantId       String
  number         String
  status         JournalStatus @default(DRAFT)
  description    String?
  sourceType     String?
  sourceId       String?
  fiscalPeriodId String?
  postedAt       DateTime?
  createdByUserId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod?  @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)
  lines        JournalLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status, postedAt])
  @@index([tenantId, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(cuid())
  tenantId       String
  journalEntryId String
  glAccountId    String
  lineNo         Int     @default(0)
  memo           String?
  debit          Decimal @default(0) @db.Decimal(14, 2)
  credit         Decimal @default(0) @db.Decimal(14, 2)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  glAccount    GlAccount    @relation(fields: [glAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId, journalEntryId])
  @@index([tenantId, glAccountId])
  @@map("journal_lines")
}

// ─── Custom Fields & Entity Views ───────────────────────────────────

enum EntityModule {
  CUSTOMERS
  PRODUCTS
  INVOICES
  ORDERS
  QUOTES
  GIFT_CARDS
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

model CustomFieldDefinition {
  id          String          @id @default(cuid())
  tenantId    String
  entity      EntityModule
  code        String
  label       String
  type        CustomFieldType @default(TEXT)
  /// For SELECT / MULTI_SELECT: string[]
  optionsJson Json?
  required    Boolean         @default(false)
  filterable  Boolean         @default(false)
  showInList  Boolean         @default(true)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity, code])
  @@index([tenantId, entity, isActive, sortOrder])
  @@map("custom_field_definitions")
}

/// Saved list layout per entity (columns, filters, sort)
model EntityListView {
  id          String       @id @default(cuid())
  tenantId    String
  entity      EntityModule
  code        String
  name        String
  description String?
  /// { columns: [{key,source}], filters: [...], sort?: {key,dir}, pageSize?: number }
  configJson  Json
  isDefault   Boolean      @default(false)
  isSystem    Boolean      @default(false)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity, code])
  @@index([tenantId, entity, isActive, sortOrder])
  @@map("entity_list_views")
}

/// Saved form layout per entity (sections + fields)
model EntityFormView {
  id          String       @id @default(cuid())
  tenantId    String
  entity      EntityModule
  code        String
  name        String
  description String?
  /// { sections: [{ id, title, fields: [{key,source,required?}] }] }
  configJson  Json
  isDefault   Boolean      @default(false)
  isSystem    Boolean      @default(false)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity, code])
  @@index([tenantId, entity, isActive, sortOrder])
  @@map("entity_form_views")
}
