# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5434/softifyos
DB_POOL_MAX=20
# Set to false if you put PgBouncer (transaction mode) in front of PostgreSQL
DB_PREPARE=true

# --- API ---
API_PORT=4000
API_HOST=127.0.0.1
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
COOKIE_SECURE=false

# --- Web Push (generate with: npm run vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Web (Next.js) ---
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Public URL of the app (customer links in emails) ---
APP_URL=http://localhost:3000

# --- Email (optional). Plesk mail server: SMTP_HOST=localhost, SMTP_PORT=25 ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SoftifyOS <no-reply@example.com>
