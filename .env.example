# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5434/softifyos
DB_POOL_MAX=20
# Set to false if you put PgBouncer (transaction mode) in front of PostgreSQL
DB_PREPARE=true

# --- API ---
API_PORT=4000
API_HOST=127.0.0.1
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
COOKIE_SECURE=false

# --- Web Push (generate with: npm run vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Web (Next.js) ---
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Public URL of the app (customer links in emails) ---
APP_URL=http://localhost:3000

# --- Email (optional). Plesk mail server: SMTP_HOST=localhost, SMTP_PORT=25 ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SoftifyOS <no-reply@example.com>

# --- Calendar sync (optional): Google Calendar / Microsoft 365 ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web), enable "Google Calendar API".
#   Authorised redirect URI: <APP_URL>/api/calendar/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra ID → App registrations → New (any organisation + personal accounts), Web redirect:
#   <APP_URL>/api/calendar/oauth/microsoft/callback   · API permissions: Calendars.ReadWrite, User.Read, offline_access
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# --- SaaS subscriptions (optional): Stripe ---
# Without STRIPE_SECRET_KEY there are no plans or limits (single-company installation).
# Stripe Dashboard → Products: one recurring price per plan and interval; Webhook endpoint: <APP_URL>/api/billing/webhook
#   events: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
STRIPE_PRICE_ENTERPRISE_MONTH=
STRIPE_PRICE_ENTERPRISE_YEAR=
# Apply plan limits without Stripe (testing)
BILLING_ENFORCE=false

# --- Monitoring (optional) ---
# A new error (API, worker or browser) is sent once to these. Webhook: Slack / Teams / Discord incoming webhook URL.
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
# Where deploy/backup.sh writes (lets /api/health report the age of the last backup)
BACKUP_DIR=/var/backups/softifyos
# Who sees Settings → System health and Settings → Backups (installation-wide), comma-separated emails
PLATFORM_ADMINS=
