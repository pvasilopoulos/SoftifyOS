{
  "name": "@softify/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/src/server.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "vapid": "tsx scripts/vapid.ts",
    "tenant:create": "tsx --env-file-if-exists=../../.env scripts/create-tenant.ts",
    "db:seed:branches": "tsx --env-file-if-exists=../../.env scripts/demo-branches.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@fastify/cookie": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.4.0",
    "jose": "^6.0.11",
    "nodemailer": "^10.6.0",
    "postgres": "^3.4.7",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "^17.5.0-beta.15",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
